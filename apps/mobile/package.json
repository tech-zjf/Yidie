{
  "name": "yidie",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-modules-core": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start --localhost",
    "ios": "EXPO_NO_TELEMETRY=1 node scripts/run-ios-simulator.mjs",
    "ios:sim": "EXPO_NO_TELEMETRY=1 node scripts/run-ios-simulator.mjs",
    "ios:release": "EXPO_NO_TELEMETRY=1 node scripts/run-ios-simulator.mjs --configuration Release",
    "test:sticker:sim": "sh scripts/test-sticker-renderer-simulator.sh",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/domain/*.test.ts src/data/*.test.ts src/preview/*.test.ts plugins/*.test.js scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "export:ios": "EXPO_NO_TELEMETRY=1 expo export --platform ios",
    "prebuild:ios": "EXPO_NO_TELEMETRY=1 expo prebuild --platform ios --no-install",
    "lint": "eslint src modules plugins scripts index.ts App.tsx",
    "format": "prettier --write src modules plugins scripts index.ts App.tsx *.json *.js",
    "format:check": "prettier --check src modules plugins scripts index.ts App.tsx *.json *.js",
    "preview:ios": "YIDIE_UI_PREVIEW=1 EXPO_PUBLIC_YIDIE_PREVIEW_CONTROLS=1 EXPO_NO_TELEMETRY=1 expo start --localhost",
    "preview:export": "YIDIE_UI_PREVIEW=1 EXPO_NO_TELEMETRY=1 expo export --platform ios --dev --output-dir dist-preview"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
