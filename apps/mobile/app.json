{
  "expo": {
    "name": "Yidie",
    "slug": "yidie",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": { "enabled": false },
    "ios": {
      "bundleIdentifier": "com.techzjf.yidie",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Yidie",
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": ["en"],
        "NSPhotoLibraryUsageDescription": "Choose outfit photos to make stickers on this iPhone. Photos are never uploaded.",
        "PHPhotoLibraryPreventAutomaticLimitedAccessAlert": true,
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.techzjf.yidie-backup",
            "UTTypeDescription": "Yidie Backup",
            "UTTypeConformsTo": ["com.apple.package"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["yidie"],
              "public.mime-type": "application/vnd.techzjf.yidie-backup"
            }
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        { "ios": { "deploymentTarget": "17.0", "enableSceneSupport": true } }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/YidieDisplay.ttf",
            "./assets/fonts/YidieDisplayItalic.ttf",
            "./assets/fonts/BagelFatOne-Regular.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-sqlite"
    ]
  }
}
